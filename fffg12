                        Camera:WorldToViewportPoint((cf * CFrame.new(-size.X/2, size.Y/2, size.Z/2)).Position),
                        Camera:WorldToViewportPoint((cf * CFrame.new(size.X/2, size.Y/2, size.Z/2)).Position),
                        Camera:WorldToViewportPoint((cf * CFrame.new(-size.X/2, -size.Y/2, size.Z/2)).Position),
                        Camera:WorldToViewportPoint((cf * CFrame.new(size.X/2, -size.Y/2, size.Z/2)).Position)
                    }

                    local function drawLine(line, p1, p2)
                        if p1.Z > 0 and p2.Z > 0 then
                            line.From = Vector2.new(p1.X, p1.Y)
                            line.To = Vector2.new(p2.X, p2.Y)
                            line.Color = color
                            line.Visible = true
                        else
                            line.Visible = false
                        end
                    end

                    -- Conectar las 12 líneas
                    drawLine(lines[1], points[1], points[2])
                    drawLine(lines[2], points[2], points[4])
                    drawLine(lines[3], points[4], points[3])
                    drawLine(lines[4], points[3], points[1])
                    drawLine(lines[5], points[5], points[6])
                    drawLine(lines[6], points[6], points[8])
                    drawLine(lines[7], points[8], points[7])
                    drawLine(lines[8], points[7], points[5])
                    drawLine(lines[9], points[1], points[5])
                    drawLine(lines[10], points[2], points[6])
                    drawLine(lines[11], points[3], points[7])
                    drawLine(lines[12], points[4], points[8])
                else
                    -- Ocultar si está muerto o desactivado
                    if Boxes[player] then
                        for _, line in pairs(Boxes[player]) do line.Visible = false end
                    end
                end
            end
        end
    end)
end)





































-- [[ MOTOR SKELETON ESP: Z-SQUAD LITE ENGINE (FIXED) ]]
_G.Skeleton_Enabled = false
_G.Skeleton_Color = "Red" 

task.spawn(function()
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local Camera = workspace.CurrentCamera
    local LP = Players.LocalPlayer

    local Skeletons = {}

    -- Función para crear una línea de hueso
    local function CreateLine()
        local line = Drawing.new("Line")
        line.Thickness = 1.5 
        line.Transparency = 1
        line.Visible = false
        return line
    end

    -- Estructura del esqueleto
    local function CreateSkeleton()
        return {
            Spine = {CreateLine(), CreateLine()}, 
            Arms = {CreateLine(), CreateLine(), CreateLine(), CreateLine()}, 
            Legs = {CreateLine(), CreateLine(), CreateLine(), CreateLine()}  
        }
    end

    -- FUNCIÓN DE LIMPIEZA TOTAL (Para cuando alguien se va)
    local function RemoveSkeleton(player)
        if Skeletons[player] then
            for _, group in pairs(Skeletons[player]) do
                for _, line in pairs(group) do
                    line.Visible = false
                    line:Remove() -- Borra la línea de la memoria
                end
            end
            Skeletons[player] = nil
        end
    end

    local function Connect(line, p1, p2, color)
        local pos1, vis1 = Camera:WorldToViewportPoint(p1.Position)
        local pos2, vis2 = Camera:WorldToViewportPoint(p2.Position)
        
        if vis1 and vis2 then
            line.From = Vector2.new(pos1.X, pos1.Y)
            line.To = Vector2.new(pos2.X, pos2.Y)
            line.Color = color
            line.Visible = true
        else
            line.Visible = false
        end
    end

    -- Evento: Si el jugador se sale, borramos sus huesos al instante
    Players.PlayerRemoving:Connect(RemoveSkeleton)

    -- Loop Maestro
    RunService.RenderStepped:Connect(function()
        local rainbow = Color3.fromHSV(tick() % 5 / 5, 1, 1)
        local color = Color3.fromRGB(255, 0, 0)
        if _G.Skeleton_Color == "Green" then color = Color3.fromRGB(0, 255, 0)
        elseif _G.Skeleton_Color == "Blue" then color = Color3.fromRGB(0, 0, 255)
        elseif _G.Skeleton_Color == "Rainbow" then color = rainbow end

        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LP then
                local char = player.Character
                -- FIX: Checkamos de entrada si el wey existe y está vivo
                if _G.Skeleton_Enabled and char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                    if not Skeletons[player] then Skeletons[player] = CreateSkeleton() end
                    local skel = Skeletons[player]

                    if char:FindFirstChild("UpperTorso") then -- R15
                        Connect(skel.Spine[1], char.Head, char.UpperTorso, color)
                        Connect(skel.Spine[2], char.UpperTorso, char.LowerTorso, color)
                        Connect(skel.Arms[1], char.UpperTorso, char.LeftUpperArm, color)
                        Connect(skel.Arms[2], char.LeftUpperArm, char.LeftHand, color)
                        Connect(skel.Arms[3], char.UpperTorso, char.RightUpperArm, color)
                        Connect(skel.Arms[4], char.RightUpperArm, char.RightHand, color)
                        Connect(skel.Legs[1], char.LowerTorso, char.LeftUpperLeg, color)
                        Connect(skel.Legs[2], char.LeftUpperLeg, char.LeftFoot, color)
                        Connect(skel.Legs[3], char.LowerTorso, char.RightUpperLeg, color)
                        Connect(skel.Legs[4], char.RightUpperLeg, char.RightFoot, color)
                    elseif char:FindFirstChild("Torso") then -- R6
                        Connect(skel.Spine[1], char.Head, char.Torso, color)
                        Connect(skel.Arms[1], char.Torso, char["Left Arm"], color)
                        Connect(skel.Arms[3], char.Torso, char["Right Arm"], color)
                        Connect(skel.Legs[1], char.Torso, char["Left Leg"], color)
                        Connect(skel.Legs[3], char.Torso, char["Right Leg"], color)
                        
                        -- Apagamos las que no usa el R6 para que no se queden estorbando
                        skel.Spine[2].Visible = false
                        skel.Arms[2].Visible = false
                        skel.Arms[4].Visible = false
                        skel.Legs[2].Visible = false
                        skel.Legs[4].Visible = false
                    end
                else
                    -- FIX: Si el jugador está muerto o el ESP apagado, forzamos visibilidad FALSE
                    if Skeletons[player] then
                        for _, group in pairs(Skeletons[player]) do
                            for _, line in pairs(group) do line.Visible = false end
                        end
                    end
                end
            end
        end
    end)
end)


































