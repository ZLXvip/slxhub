            _G.ESP_High_Outline = 1 -- Totalmente transparente (sin borde)
        elseif num == 2 then
            _G.ESP_High_Outline = 0 -- Sólido (con borde)
        end
    end
})

-- 3. Modo Relleno (Input de Texto)
RenderTab:Input({
    Title = "Modo Relleno (1, 2, 3)",
    Desc = "1: Sólido | 2: 0.5 Trans | 3: Invisible",
    Default = "2",
    Placeholder = "Escribe 1, 2 o 3...",
    Callback = function(val)
        local num = tonumber(val)
        if num == 1 then
            _G.ESP_High_Fill = 0   -- Sólido
        elseif num == 2 then
            _G.ESP_High_Fill = 0.5 -- Transparente
        elseif num == 3 then
            _G.ESP_High_Fill = 1   -- Invisible
        end
    end
})

