-- // Función para el Sonido Premium // --
local function PlayToggleSound()
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://138567614125924" -- El ID que pasaste
    sound.Volume = 2
    sound.Parent = game:GetService("SoundService")
    sound:Play()
    sound.Ended:Connect(function()
        sound:Destroy() -- Se borra solo para no dar lag
    end)
end

