-- [[ MOTOR DE Anti Hit ]]
_G.Zinvis = false

game:GetService("RunService").Heartbeat:Connect(function()
    local lp = game.Players.LocalPlayer
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")

    if _G.Zinvis and root and hum and hum.Health > 0 then
        local oldPos = root.CFrame
        -- Te manda al vacío para que nadie te pegue
        root.CFrame = oldPos * CFrame.new(0, 999, 0)
        
        -- Fix de Cámara: Mantiene tu vista donde está la acción
        hum.CameraOffset = Vector3.new(0, -999, 0)
        
        -- Regreso instantáneo: El secreto para que el arma dispare
        game:GetService("RunService").RenderStepped:Wait()
        root.CFrame = oldPos
    elseif hum then
        -- Limpiamos la cámara si se apaga el Ghost
        hum.CameraOffset = Vector3.new(0, 0, 0)
    end
end)

































































